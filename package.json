		"astro": "^5.13.7",
		"fflate": "^0.8.2",
		"idb-keyval": "^6.2.2",
		"logrocket": "^10.1.0",
		"p-limit": "^7.1.1",
		"qrcode": "^1.5.4",
		"solid-js": "^1.9.9",
		"tailwindcss": "^4.1.13",
		"vitest": "^3.2.4"
	},
	"devDependencies": {
